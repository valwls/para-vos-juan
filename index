let state=JSON.parse(localStorage.getItem(KEY)||'null')||{dates:INITIAL,memories:[],story:{title:'',text:''}};
let currentLetter='ALL';

function save(){localStorage.setItem(KEY,JSON.stringify(state));updateStats();renderList();renderMemories()}

function unlock(){
  const p=document.getElementById('password').value;
  if(p===PASS){
    sessionStorage.setItem('open','1');
    document.getElementById('lock').classList.add('hidden');
    document.getElementById('app').classList.remove('hidden');
    init();
  }else{
    document.getElementById('loginError').textContent='Esa no es nuestra contraseña ♡';
  }
}

document.getElementById('password').addEventListener('keydown',e=>{if(e.key==='Enter')unlock()});

function init(){
  updateStats();
  renderLetters();
  renderList();
  renderMemories();
  document.getElementById('storyTitle').value=state.story.title||'';
  document.getElementById('storyText').value=state.story.text||'';
}

if(sessionStorage.getItem('open')){
  document.getElementById('lock').classList.add('hidden');
  document.getElementById('app').classList.remove('hidden');
  init();
}

function showView(id,btn){document.querySelectorAll('.view').forEach(x=>x.classList.remove('active'));document.getElementById(id).classList.add('active');document.querySelectorAll('.navlinks button').forEach(x=>x.classList.remove('active'));btn.classList.add('active')}
function updateStats(){let d=state.dates.filter(x=>x.done).length,t=state.dates.length;document.getElementById('total').textContent=t;document.getElementById('done').textContent=d;document.getElementById('left').textContent=t-d;document.getElementById('progressText').textContent=d+' / '+t;document.getElementById('progressBar').style.width=(t?d/t*100:0)+'%'}
function randomDate(){const p=state.dates.filter(x=>!x.done);if(!p.length){toast('¡Completaron todas las citas! ♡');return}const d=p[Math.floor(Math.random()*p.length)];document.getElementById('dateCard').innerHTML='<div style="text-align:center"><div class="date-letter">CITA · '+d.letter+'</div><div class="date-text">'+esc(d.text)+'</div><div class="actions" style="justify-content:center"><button class="primary" onclick="markDone(\\''+d.id+'\\')">♡ La hicimos</button><button class="ghost" onclick="randomDate()">🔄 Otra</button></div></div>'}
function markDone(id){const d=state.dates.find(x=>x.id===id);d.done=true;d.completedAt=new Date().toLocaleDateString('es-AR');save();toast('Cita guardada como recuerdo ♡');setTimeout(randomDate,300)}
function renderLetters(){document.getElementById('letters').innerHTML='<button class="'+(currentLetter==='ALL'?'active':'')+'" onclick="setLetter(\\'ALL\\')">Todas</button>'+[...'ABCDEFGHIJKLMNOPQRSTUVWXYZ'].map(l=>'<button class="'+(currentLetter===l?'active':'')+'" onclick="setLetter(\\''+l+'\\')">'+l+'</button>').join('')}
function setLetter(l){currentLetter=l;renderLetters();renderList()}
function renderList(){const q=(document.getElementById('search')?.value||'').toLowerCase();let a=state.dates.filter(x=>(currentLetter==='ALL'||x.letter===currentLetter)&&x.text.toLowerCase().includes(q));document.getElementById('dateList').innerHTML=a.map(d=>'<div class="item '+(d.done?'done':'')+'"><button class="check" onclick="toggleDone(\\''+d.id+'\\')"></button><div style="flex:1"><div class="txt">'+esc(d.text)+'</div><div class="meta">'+d.letter+' · '+(d.done?'Hecha '+(d.completedAt||''):'Pendiente')+'</div></div>'+(d.custom?'<div class="small-actions"><button onclick="deleteDate(\\''+d.id+'\\')">🗑️</button></div>':'')+'</div>').join('')||'<div class="panel">No hay citas con ese filtro ♡</div>'}
function toggleDone(id){const d=state.dates.find(x=>x.id===id);d.done=!d.done;d.completedAt=d.done?new Date().toLocaleDateString('es-AR'):'';save()}
function openAdd(){openModal('Agregar una cita','<div class="formgrid"><input id="newLetter" maxlength="1" placeholder="Letra (A-Z)"><textarea id="newText" rows="4" placeholder="Escribí la nueva cita…"></textarea><button class="primary" onclick="addDate()">Agregar ♡</button></div>')}
function addDate(){let l=(document.getElementById('newLetter').value||'').toUpperCase().trim(),t=document.getElementById('newText').value.trim();if(!/^[A-Z]$/.test(l)||!t)return toast('Completá la letra y la cita ♡');state.dates.push({id:'C'+Date.now(),letter:l,text:t,done:false,custom:true});state.dates.sort((a,b)=>a.letter.localeCompare(b.letter)||a.text.localeCompare(b.text));save();closeModal()}
function deleteDate(id){if(confirm('¿Eliminar esta cita?')){state.dates=state.dates.filter(x=>x.id!==id);save()}}
function saveStory(){state.story={title:document.getElementById('storyTitle').value,text:document.getElementById('storyText').value};save();toast('Nuestra historia quedó guardada ♡')}
function openMemory(){openModal('Guardar un recuerdo','<div class="formgrid"><input id="mTitle" placeholder="Título"><input id="mDate" type="date"><input id="mPhoto" type="file" accept="image/*"><textarea id="mNote" rows="4" placeholder="¿Qué pasó? ¿Cómo se sintieron?"></textarea><button class="primary" onclick="addMemory()">Guardar recuerdo ♡</button></div>')}
function addMemory(){const f=document.getElementById('mPhoto').files[0],m={title:document.getElementById('mTitle').value||'Nuestro recuerdo',date:document.getElementById('mDate').value,note:document.getElementById('mNote').value};if(f){const r=new FileReader();r.onload=()=>{m.img=r.result;state.memories.unshift(m);save();closeModal()};r.readAsDataURL(f)}else{state.memories.unshift(m);save();closeModal()}}
function renderMemories(){document.getElementById('memoryList').innerHTML=state.memories.map((m,i)=>'<article class="memory">'+(m.img?'<img src="'+m.img+'">':'')+'<div class="memory-body"><b>'+esc(m.title)+'</b><div class="meta">'+(m.date||'')+'</div><p>'+esc(m.note||'')+'</p><button class="ghost" onclick="deleteMemory('+i+')">Eliminar</button></div></article>').join('')||'<div class="panel">Todavía no hay recuerdos. Guarden acá los momentos especiales ♡</div>'}
function deleteMemory(i){if(confirm('¿Eliminar este recuerdo?')){state.memories.splice(i,1);save()}}
function openModal(t,b){document.getElementById('modalTitle').textContent=t;document.getElementById('modalBody').innerHTML=b;document.getElementById('modal').classList.add('show')}
function closeModal(){document.getElementById('modal').classList.remove('show')}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]))}
function toast(t){const x=document.createElement('div');x.textContent=t;x.style='position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#4b3940;color:#fff;padding:12px 18px;border-radius:14px;z-index:100';document.body.appendChild(x);setTimeout(()=>x.remove(),2200)}
</script></body></html>
