<div id="lock"><div class="lock-card"><div class="heart">♡</div><h1>Our Little Dates</h1><p class="subtitle">Un montón de planes, una historia para vivirlos todos.</p><div class="row"><input id="password" type="password" placeholder="Nuestra contraseña"></div><button class="primary bigbtn" style="width:100%" onclick="unlock()">Entrar ♡</button><div id="loginError" class="error"></div></div></div>
